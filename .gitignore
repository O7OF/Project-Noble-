# Ignore user data and large binaries in data/, but keep blocks, json configs, and the public mainmenu_all.map mod
data/userdata/
data/armor/
data/sandbox/
data/autosave/
data/mods/
data/*.map

# Reverse engineering and decompilation evidence/artifacts
tests/evidence/
docs/*reverse*
docs/*decomp*
docs/reach_renaissance_reverse_engineering_report.md
preferences.dat
*dumpbin*
dumpbin.txt

# Large local game / RR files: never in git (GitHub limit 100 MB). Copy them from your own MCC / RR install.
**/menumaps/
**/data/armor/
*.map
!data/menumaps/
!data/menumaps/*.string_ids.csv
*.rdc
*.obj
*.mtl
profile_*.bin
# The embedded profile is a build input (src/res/blocks.rc), not a user save file.
!data/profile_1.bin
rr_profile*.bin
# test/runtime artifacts that must never be committed
reports/
gamestate.txt
*.headerdump

# Extended engine limit recipes (contain Reach code bytes; local reference only)
tools/limits/recipes/
# Generated engine-limit patch files (run tools/limits/build_recipe.py v16)
data/limits/*.nlp

__pycache__/
