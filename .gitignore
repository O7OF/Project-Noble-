# Build directories
build/
build-rel/
build-release/
build-*.log
dist/
bin/
obj/
**/bin/
**/obj/
out/
.vs/
*.user
*.suo
node_modules/
**/node_modules/

# Local cache & agent workspace
.agents/
*.log
*.dmp
imgui.ini
bin/vgmstream/
vgmstream/
scratch/
# Ignore user data and large binaries in data/, but keep blocks and json configs
data/userdata/
# The menu map (298 MB) is a mod and the armor pack (103 MB) is local-only: both are release-zip
# assets, not repo files. The small string tables next to the map are source and must be present
# for a fresh checkout to build/run the Armory.
data/menumaps/*.map
data/armor/
data/sandbox/
data/autosave/
data/mods/
data/*.map

# Reverse engineering and decompilation evidence/artifacts
tests/evidence/
docs/*reverse*
docs/*decomp*
docs/reach_renaissance_reverse_engineering_report.md
preferences.dat
*dumpbin*
dumpbin.txt

# Large local game / RR files: never in git (GitHub limit 100 MB). Copy them from your own MCC / RR install.
**/menumaps/
**/data/armor/
*.map
*.rdc
*.obj
*.mtl
profile_*.bin
# The embedded profile is a build input (src/res/blocks.rc), not a user save file.
!data/profile_1.bin
rr_profile*.bin
# test/runtime artifacts that must never be committed
reports/
gamestate.txt
*.headerdump
