#include "resource.h"
#include "blocks.rc"

IDI_NOBLE_ICON ICON "noble.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,19,28,0
PRODUCTVERSION  0,19,28,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Project Noble Team\0"
            VALUE "FileDescription",  "Project Noble Game Client\0"
            VALUE "FileVersion",      "0.19.28.0\0"
            VALUE "InternalName",     "noble-client\0"
            VALUE "LegalCopyright",   "Project Noble Team. Non-commercial community mod.\0"
            VALUE "OriginalFilename", "noble-client.exe\0"
            VALUE "ProductName",      "Project Noble\0"
            VALUE "ProductVersion",   "0.19.28.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

